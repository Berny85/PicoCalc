# Konfiguration für backup-picocalc.sh
# Kopieren nach /etc/picocalc-backup.env und anpassen (nur nötig, wenn die Vorgaben nicht passen).

# Datenbank (Docker-Container auf dem NUC)
DB_CONTAINER=picocalc-db
DB_USER=printuser
DB_NAME=printcalc

# Was gesichert wird
STORAGE_DIR=/srv/containers/picocalc/storage
ENV_FILE=/srv/containers/picocalc/.env        # leer lassen, um die .env (Passwörter) nicht auf den OMV zu legen

# Ziel: hier wird der NFS-Share des OMV eingebunden (siehe README.md / fstab)
MOUNT_POINT=/mnt/omv-backup
BACKUP_DIR=/mnt/omv-backup/picocalc
REQUIRE_MOUNT=1                                # 1 = abbrechen, wenn der Share nicht eingebunden ist

# Aufbewahrung
KEEP_DAILY=14                                  # tägliche Stände
KEEP_WEEKLY=8                                  # Sonntags-Stände
